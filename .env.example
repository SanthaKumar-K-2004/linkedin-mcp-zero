# ==============================================================================
# LinkedIn MCP Zero - Production Environment Configuration
# ==============================================================================

# Server Transport & Networking
# Choices: stdio (for local IDE / CLI clients), streamable-http (for remote / cloud hosting)
LINKEDIN_MCP_TRANSPORT=stdio
LINKEDIN_MCP_HOST=127.0.0.1
LINKEDIN_MCP_PORT=8000
LINKEDIN_MCP_LOG_LEVEL=INFO

# Security & Authentication (Required for remote streamable-http hosting)
# Header: x-api-key: <token> OR Authorization: Bearer <token>
LINKEDIN_MCP_API_KEY=
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8080

# Performance & Caching
LINKEDIN_MCP_TIMEOUT_SECONDS=15
LINKEDIN_MCP_CACHE_TTL_SECONDS=300

# Optional Outbound Proxy (for rotating IPs or datacenter bypass)
HTTP_PROXY=
HTTPS_PROXY=

# Optional AI Reasoning (for AI-powered cover letters & resume suggestions)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Browser Automation (Opt-in only, requires local Chrome CDP)
LINKEDIN_MCP_ENABLE_BROWSER=false
LINKEDIN_MCP_CDP_URL=http://127.0.0.1:9222
LINKEDIN_MCP_BROWSER_IDLE_SECONDS=300
LINKEDIN_MCP_ENABLE_PATCHRIGHT_FALLBACK=false
LINKEDIN_MCP_BROWSER_USER_DATA_DIR=

# Optional Authenticated Session Cookie (Only needed for private account tools)
LI_AT=
