# --- Transport ---------------------------------------------------------------
LINKEDIN_MCP_TRANSPORT=stdio
LINKEDIN_MCP_HOST=127.0.0.1
LINKEDIN_MCP_PORT=8000
LINKEDIN_MCP_LOG_LEVEL=INFO

# --- Public scraping engine ----------------------------------------------------
LINKEDIN_MCP_TIMEOUT_SECONDS=15
LINKEDIN_MCP_CACHE_TTL_SECONDS=300
# Route guest-API traffic through a proxy (optional):
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# --- HTTP transport security (streamable-http only) -----------------------------
# API_KEY=change-me
# RATE_LIMIT_PER_MINUTE=60
# JSON array of allowed origins, e.g. CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# CORS_ALLOWED_ORIGINS=["*"]

# --- OAuth 2.1 (streamable-http only, needs [oauth] extra) -----------------------
# LINKEDIN_MCP_OAUTH_METADATA_URL=
# LINKEDIN_MCP_OAUTH_CLIENT_ID=
# LINKEDIN_MCP_OAUTH_CLIENT_SECRET=
# LINKEDIN_MCP_OAUTH_SERVER_URL=

# --- Browser mode (opt-in) --------------------------------------------------------
LINKEDIN_MCP_ENABLE_BROWSER=false
LINKEDIN_MCP_CDP_URL=http://127.0.0.1:9222
LINKEDIN_MCP_BROWSER_IDLE_SECONDS=300
LINKEDIN_MCP_ENABLE_PATCHRIGHT_FALLBACK=false
LINKEDIN_MCP_BROWSER_USER_DATA_DIR=

# --- Gated private API (disabled, risk-reviewed later) -----------------------------
LINKEDIN_MCP_ENABLE_VOYAGER=false
# LI_AT=

# --- Resume / storage ---------------------------------------------------------------
# LINKEDIN_MCP_DATA_DIR=
# JSON list of extra directories resumes may be read from:
# LINKEDIN_MCP_ALLOWED_RESUME_DIRS=["/home/me/cv"]

# --- LLM-assisted tools (optional) ----------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LINKEDIN_MCP_LLM_MODEL=claude-sonnet-4-5

# --- Exact token counting (sends response text to Anthropic when enabled) -------------
LINKEDIN_MCP_EXACT_TOKEN_COUNT=false
LINKEDIN_MCP_TOKEN_COUNT_MODEL=claude-sonnet-4-5

# --- Metrics ---------------------------------------------------------------------------
LINKEDIN_MCP_METRICS_MAX_ROWS=5000

# --- Telemetry (needs [observability] extra; spans go to stderr) -------------------------
# LINKEDIN_MCP_ENABLE_TELEMETRY=1
